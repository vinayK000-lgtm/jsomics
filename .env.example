# JSOMICS — Environment variables
# Copy: cp .env.example .env  then fill in your values

ENV=development
APP_NAME=JSOMICS
PUBLIC_SITE_URL=https://jsomics.com

# Supabase — get from Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_ID:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# NCBI / PubMed
NCBI_EMAIL=your@email.com
NCBI_API_KEY=

# Static API keys (comma-separated, for scripts/bots)
BIO_RESEARCH_API_KEYS=jsom_your_secret_key_here

# CORS (comma-separated)
ALLOWED_ORIGINS=https://jsomics.com,http://localhost:3000

# Rate limits (per day)
RATE_LIMIT_FREE=100
RATE_LIMIT_RESEARCHER=10000
RATE_LIMIT_LAB=999999
