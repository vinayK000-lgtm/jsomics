# JSOMICS environment variables for Vercel-only deployment
# Add these in Vercel Project Settings > Environment Variables.

ENV=production
APP_NAME=JSOMICS
PUBLIC_SITE_URL=https://jsomics.com
LIVE_EVIDENCE_ENABLED=true

# Supabase is still used for login, plans, users, API counts, and saved reports.
# It is NOT used for temporary PubMed/PubChem/KEGG evidence cache in this version.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
# Optional. Leave empty if you do not want a permanent evidence repository.
SUPABASE_DATABASE_URL=
DATABASE_URL=

# NCBI / PubMed
NCBI_EMAIL=your@email.com
NCBI_API_KEY=

# Temporary cache: Vercel KV or Upstash Redis REST.
# Vercel KV usually provides KV_REST_API_URL and KV_REST_API_TOKEN automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_TTL_SECONDS=86400

# GPT / Claude analysis. Set one provider or both.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# CORS
ALLOWED_ORIGINS=https://jsomics.com,https://www.jsomics.com

# Rate limits per day
RATE_LIMIT_FREE=100
RATE_LIMIT_RESEARCHER=10000
RATE_LIMIT_LAB=999999

# Ultimate fast job engine
SOURCE_TIMEOUT_SECONDS=10
JOB_TTL_SECONDS=3600
